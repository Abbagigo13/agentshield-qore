# Testnet only. Never put a mainnet key here.
AGENTSHIELD_NETWORK=testnet
AGENTSHIELD_MNEMONIC="twelve or twenty four words of a FUNDED TESTNET account"
AGENTSHIELD_DRY_RUN=0          # 1 = build+sign hybrid txs but never broadcast
AGENTSHIELD_ADMIN_TOKEN=change-me
AGENT_KEYS=agent-alpha:key-alpha,agent-beta:key-beta
AGENTSHIELD_RECIPIENTS=qor1...,qor1...   # allowlist
AGENTSHIELD_POLICIES=policies.json
AGENTSHIELD_MCP_AGENT=mcp-agent
# Delegated mode: the chain itself bounds what the gateway can spend (see docs/SECURITY.md)
# AGENTSHIELD_MODE=delegated            # default: direct
# AGENTSHIELD_OWNER_ADDRESS=qor1...     # account holding the funds (default: account 0 of AGENTSHIELD_MNEMONIC)
# AGENTSHIELD_RELAYER_MNEMONIC=...      # fee-paying relayer wallet (default: account 1 of AGENTSHIELD_MNEMONIC)
# AGENTSHIELD_DELEGATE_SEED=...         # 64 hex chars (default: ed25519 key 2 of AGENTSHIELD_MNEMONIC)
